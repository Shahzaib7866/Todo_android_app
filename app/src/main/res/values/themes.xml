<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.TodoApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondaryContainer">@color/yellow</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
    </style>

    <style name="Theme.TodoApp" parent="Base.Theme.TodoApp" />

    <style name="CompactBottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">56dp</item>
        <item name="itemMinHeight">56dp</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="itemActiveIndicatorStyle">@style/CompactActiveIndicator</item>
    </style>

    <style name="CompactActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:height">26dp</item>
        <item name="android:width">52dp</item>
    </style>

</resources>