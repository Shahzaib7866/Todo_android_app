<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.TodoApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondaryContainer">@color/yellow</item>
        <item name="colorOnSecondaryContainer">@color/black</item>

        <item name="materialAlertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="materialCalendarTheme">@style/CustomDatePickerTheme</item>
    </style>

    <style name="Theme.TodoApp" parent="Base.Theme.TodoApp" />

    <style name="CustomChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
    </style>

    <!-- Dialog Theme for Alert Dialogs (Delete Dialog) -->
    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">#424242</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">#424242</item>
    </style>

    <!-- Dialog Theme for Calendar MaterialDatePicker -->
    <style name="CustomDatePickerTheme" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">#424242</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">#424242</item>

        <!-- Override "Cancel" and "OK" Buttons Text Color to Black -->
        <item name="buttonBarNegativeButtonStyle">@style/DatePickerButton.Black</item>
        <item name="buttonBarPositiveButtonStyle">@style/DatePickerButton.Black</item>
    </style>

    <style name="DatePickerButton.Black" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CompactBottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">56dp</item>
        <item name="itemMinHeight">56dp</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="itemActiveIndicatorStyle">@style/CompactActiveIndicator</item>
    </style>

    <style name="CompactActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:height">26dp</item>
        <item name="android:width">52dp</item>
    </style>

</resources>
